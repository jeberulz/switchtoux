{
  "$description": "Rules for expanding canonical tokens into Figma-ready variable metadata and Tailwind aliases.",
  "schemaVersion": "1.0.0",
  "collectionRules": [
    { "source": "semantic.json", "prefix": "color.", "collection": "Semantic Color", "mode": "Dark" },
    { "source": "typography.json", "prefix": "typography.", "collection": "Typography", "mode": "Value" },
    { "source": "typography.json", "prefix": "font.", "collection": "Typography", "mode": "Value" },
    { "source": "motion.json", "prefix": "motion.", "collection": "Motion", "mode": "Value" },
    { "source": "primitives.json", "prefix": "duration.", "collection": "Motion", "mode": "Value" },
    { "source": "primitives.json", "prefix": "easing.", "collection": "Motion", "mode": "Value" },
    { "source": "primitives.json", "prefix": "dimension.space.", "collection": "Spacing", "mode": "Value" },
    { "source": "primitives.json", "prefix": "dimension.radius.", "collection": "Radius", "mode": "Value" },
    { "source": "semantic.json", "prefix": "layout.", "collection": "Spacing", "mode": "Value" },
    { "source": "primitives.json", "prefix": "", "collection": "Primitives", "mode": "Value" },
    { "source": "semantic.json", "prefix": "", "collection": "Primitives", "mode": "Value" },
    { "source": "component.json", "prefix": "", "collection": "Primitives", "mode": "Value" }
  ],
  "scopeByType": {
    "color": ["ALL_FILLS", "STROKE_COLOR"],
    "dimension": ["WIDTH_HEIGHT", "GAP", "CORNER_RADIUS"],
    "number": ["ALL_SCOPES"],
    "duration": ["ALL_SCOPES"],
    "cubicBezier": ["ALL_SCOPES"],
    "fontFamily": ["FONT_FAMILY"],
    "fontWeight": ["FONT_WEIGHT"],
    "shadow": ["EFFECT"]
  },
  "cssVariables": {
    "color.background.canvas": "--color-bg",
    "color.surface.default": "--color-surface",
    "color.surface.raised": "--color-surface-raised",
    "color.surface.hover": "--color-surface-hover",
    "color.border.subtle": "--color-border-subtle",
    "color.border.default": "--color-border",
    "color.border.strong": "--color-border-strong",
    "color.border.control": "--color-border-control",
    "color.text.primary": "--color-text-primary",
    "color.text.secondary": "--color-text-secondary",
    "color.text.muted": "--color-text-muted",
    "color.text.disabled": "--color-text-disabled",
    "color.text.onAction": "--color-text-on-action",
    "color.action.primary": "--color-accent",
    "color.action.hover": "--color-accent-hover",
    "color.action.pressed": "--color-accent-pressed",
    "color.action.soft": "--color-accent-soft",
    "color.action.line": "--color-accent-line",
    "color.action.glow": "--color-accent-glow",
    "color.status.success.signal": "--color-success",
    "color.status.warning.signal": "--color-warning",
    "color.status.info.signal": "--color-info",
    "color.status.error.signal": "--color-error",
    "effect.shadow.raised": "--shadow-raised",
    "effect.shadow.accent": "--shadow-accent",
    "effect.focusRing": "--focus-ring",
    "font.family.sans": "--font-family-sans",
    "font.family.mono": "--font-family-mono",
    "dimension.space.1": "--space-1",
    "dimension.space.2": "--space-2",
    "dimension.space.3": "--space-3",
    "dimension.space.4": "--space-4",
    "dimension.space.5": "--space-5",
    "dimension.space.6": "--space-6",
    "dimension.space.7": "--space-7",
    "dimension.space.8": "--space-8",
    "dimension.space.9": "--space-9",
    "dimension.space.10": "--space-10",
    "dimension.space.11": "--space-11",
    "dimension.radius.card": "--radius-card",
    "dimension.radius.control": "--radius-control",
    "dimension.radius.small": "--radius-small",
    "dimension.radius.pill": "--radius-pill"
  },
  "tailwindAliases": {
    "color.canvas": "color.background.canvas",
    "color.panel": "color.surface.default",
    "color.panel-raised": "color.surface.raised",
    "color.ink": "color.text.primary",
    "color.ink-secondary": "color.text.secondary",
    "color.ink-muted": "color.text.muted",
    "color.brand": "color.action.primary",
    "color.brand-hover": "color.action.hover",
    "color.brand-pressed": "color.action.pressed",
    "font.sans": "font.family.sans",
    "font.mono": "font.family.mono",
    "breakpoint.mobile": "layout.breakpoint.mobile",
    "breakpoint.tablet": "layout.breakpoint.tablet",
    "breakpoint.comparison": "layout.breakpoint.comparison",
    "breakpoint.desktop": "layout.breakpoint.desktop",
    "breakpoint.wide": "layout.breakpoint.wide",
    "breakpoint.canvas": "layout.breakpoint.canvas"
  }
}
