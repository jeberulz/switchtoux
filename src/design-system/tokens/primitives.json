      "readingHero": { "$type": "dimension", "$value": "620px", "$description": "Hero supporting-copy width." },
      "readingArticle": { "$type": "dimension", "$value": "680px", "$description": "Long-form article width." },
      "readingCourse": { "$type": "dimension", "$value": "720px", "$description": "Course introduction width." },
