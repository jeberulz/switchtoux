    "neutral": {
      "black": { "$type": "color", "$value": "#000000", "$description": "Absolute black canvas." },
      "zinc950": { "$type": "color", "$value": "#18181b", "$description": "Lowest zinc surface." },
      "zinc900": { "$type": "color", "$value": "#27272a", "$description": "Raised zinc surface and subtle border." },
      "zinc850": { "$type": "color", "$value": "#303036", "$description": "Interactive zinc hover surface." },
      "zinc700": { "$type": "color", "$value": "#3f3f46", "$description": "Standard decorative zinc border." },
      "zinc600": { "$type": "color", "$value": "#52525b", "$description": "Strong decorative zinc border." },
      "zinc500": { "$type": "color", "$value": "#71717a", "$description": "Accessible interactive boundary and disabled text." },
      "zinc400": { "$type": "color", "$value": "#a1a1aa", "$description": "Muted zinc text." },
      "zinc300": { "$type": "color", "$value": "#d4d4d8", "$description": "Secondary zinc text." },
      "white": { "$type": "color", "$value": "#ffffff", "$description": "Primary white text and focus ring." }
