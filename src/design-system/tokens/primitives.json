      "revealMaximum": { "$type": "dimension", "$value": "20px", "$description": "Maximum scroll-reveal translation." },
      "parallaxMinimum": { "$type": "dimension", "$value": "4px", "$description": "Minimum pointer-parallax range." },
      "parallaxMaximum": { "$type": "dimension", "$value": "8px", "$description": "Maximum pointer-parallax range." }
