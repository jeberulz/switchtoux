    "rose": {
      "default": { "$type": "color", "$value": "#f43f5e", "$description": "Primary rose signal." },
      "hover": { "$type": "color", "$value": "#fb7185", "$description": "Rose hover and error signal." },
      "pressed": { "$type": "color", "$value": "#e21e49", "$description": "Accessibility-corrected pressed rose." }
    },
    "signal": {
      "success": { "$type": "color", "$value": "#34d399", "$description": "Success signal." },
      "warning": { "$type": "color", "$value": "#fbbf24", "$description": "Warning signal." },
