  "number": {
    "grid": {
      "mobileColumns": { "$type": "number", "$value": 4, "$description": "Mobile grid columns." },
      "tabletColumns": { "$type": "number", "$value": 8, "$description": "Tablet grid columns." },
      "desktopColumns": { "$type": "number", "$value": 12, "$description": "Desktop grid columns." }
    },
    "layer": {
      "base": { "$type": "number", "$value": 0, "$description": "Base document layer." },
      "content": { "$type": "number", "$value": 10, "$description": "Raised content layer." },
      "sticky": { "$type": "number", "$value": 20, "$description": "Sticky interface layer." },
      "overlay": { "$type": "number", "$value": 40, "$description": "Overlay backdrop layer." },
      "modal": { "$type": "number", "$value": 50, "$description": "Dialog and modal layer." },
      "toast": { "$type": "number", "$value": 60, "$description": "Transient notification layer." }
    },
    "opacity": {
      "disabled": { "$type": "number", "$value": 0.58, "$description": "Disabled-content opacity when opacity is unavoidable." },
      "decorative": { "$type": "number", "$value": 0.6, "$description": "Decorative atmosphere ceiling." }
    }
  },
  "duration": {
    "instant": { "$type": "duration", "$value": "0ms", "$description": "Immediate reduced-motion state change." },
    "fast": { "$type": "duration", "$value": "120ms", "$description": "Fast state feedback." },
    "standard": { "$type": "duration", "$value": "200ms", "$description": "Standard interaction transition." },
    "menu": { "$type": "duration", "$value": "240ms", "$description": "Mobile navigation reveal within the approved range." },
    "emphasis": { "$type": "duration", "$value": "420ms", "$description": "Emphasised reveal transition." },
    "entrance": { "$type": "duration", "$value": "700ms", "$description": "Maximum hero-copy entrance sequence." },
    "ambient": { "$type": "duration", "$value": "8000ms", "$description": "Ambient path movement." }
  },
  "easing": {
    "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1], "$description": "Linear ambient progression." },
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1], "$description": "Standard interface easing." },
    "emphasis": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1], "$description": "Emphasised reveal easing." }
  },
  "shadow": {
    "raised": { "$type": "shadow", "$value": "0 24px 80px rgba(0, 0, 0, 0.42)", "$description": "Raised panel shadow." },
    "accent": { "$type": "shadow", "$value": "0 0 64px rgba(244, 63, 94, 0.18)", "$description": "Rose atmospheric shadow." },
    "focusRing": { "$type": "shadow", "$value": "0 0 0 2px #f43f5e, 0 0 0 4px #ffffff", "$description": "Two-stage rose inner and white outer focus treatment." }
